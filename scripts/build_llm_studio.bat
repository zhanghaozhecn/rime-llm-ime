@echo off
REM build_llm_studio.bat - WeaselLLMStudio.exe x64 Release (cl direct build)
REM LLM settings + live debug combined window (tabbed shell; generated by
REM   scripts\gen_studio.py from WeaselLLMSetup.cpp + WeaselLLMDebug.cpp).
REM Manifest: explicit (v6 common controls + system DPI awareness) - see
REM   weasel\WeaselLLMStudio\WeaselLLMStudio.manifest.
setlocal
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat" >nul 2>&1
cl /nologo /utf-8 /O2 /W3 /EHsc /DUNICODE /D_UNICODE /DWIN32_LEAN_AND_MEAN ^
   "%~dp0..\weasel\WeaselLLMStudio\WeaselLLMStudio.cpp" ^
   /Fe:"%~dp0..\bin\WeaselLLMStudio.exe" /Fo:"%TEMP%\llm_studio.obj" ^
   /link /SUBSYSTEM:WINDOWS /MANIFEST:EMBED ^
   /MANIFESTINPUT:"%~dp0..\weasel\WeaselLLMStudio\WeaselLLMStudio.manifest" ^
   /MANIFESTDEPENDENCY:"type='win32' name='Microsoft.Windows.Common-Controls' version='6.0.0.0' processorArchitecture='*' publicKeyToken='6595b64144ccf1df' language='*'" ^
   user32.lib gdi32.lib comdlg32.lib shell32.lib ole32.lib
if errorlevel 1 (echo BUILD FAILED & exit /b 1)
echo BUILD OK
